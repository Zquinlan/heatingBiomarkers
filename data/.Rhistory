mutate(log = log10(sym_sa))%>%
mutate(Health = as.factor(Health),
Health = fct_relevel(Health, "Bleached", "Partially bleached"))%>%
ggplot(aes(x = Day, y = log, color = Health)) +
geom_point() +
geom_boxplot() +
scale_color_manual(values = health_colors) +
facet_wrap(~ Health) +
gen_theme()
